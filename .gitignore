# Node / frontend
node_modules/
dist/
.vite/

# Salida de tsc suelta dentro de src/ (Vite resolvería .js antes que .ts
# y taparía los fuentes; los commits solo llevan .ts/.tsx)
src/**/*.js
src/**/*.js.map

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Python
__pycache__/
*.pyc
.venv/
build/
dist/
*.egg-info/

# Sidecar binaries (descargados desde GitHub Releases en build)
src-tauri/binaries/

# Misc
.DS_Store

# Logs de depuración de una instancia lanzada a mano (stdout/stderr redirigidos)
.dev-stdout.log
.dev-stderr.log

# Entorno (secretos locales)
.env
.env.local

# Claves de firma (NUNCA versionar; viven fuera del repo)
*.key
*.key.pub

