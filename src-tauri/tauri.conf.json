{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoson Desktop",
  "version": "0.1.0-alpha.4",
  "identifier": "lat.phoson.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phoson Desktop",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwRDg3Qjk5MjFCNUQzQjEKUldTeDA3VWhtWHZZZ0RiZlF2bHpzWkhPNCsyWjMxZVdKUEVkenQrakk2djQ1clNoL1poTGFkUmQK",
      "endpoints": [
        "https://github.com/phoson-lat/Phoson-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
