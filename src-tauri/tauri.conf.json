{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoson Desktop",
  "version": "0.1.0-alpha.1",
  "identifier": "lat.phoson.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phoson Desktop",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NDNDRUEwNEU1MjhEODAKUldTQWpWSk9vTTVENXZWRExlM2Fic3lUeXM0eTVqOUJjaFZWaFRRMjkyTzBwbFpWOVBzQnhsS04K",
      "endpoints": [
        "https://github.com/phoson-lat/Phoson-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
